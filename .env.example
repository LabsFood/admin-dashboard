# ─────────────────────────────────────────────────────────────────────────────
# Console d'administration Lab's Food — variables d'environnement
# Copier ce fichier vers `.env` puis renseigner les valeurs.
# ─────────────────────────────────────────────────────────────────────────────

# Authentication (Clerk) — login uniquement, pas d'inscription.
# La console réutilise l'instance Clerk de l'espace client. L'accès est réservé
# aux comptes dont public_metadata.role === "admin" (garde middleware + layout).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
# Filet de sécurité : aucune inscription depuis la console. Toute redirection
# Clerk vers un écran d'inscription retombe sur /login au lieu du portail
# hébergé accounts.*.clerk.accounts.dev/sign-up.
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login

# Backend API Labs Food (NestJS) — source de vérité du rôle et des données.
# En dev, on passe par un proxy same-origin (/lf-api) pour éviter le CORS :
# le navigateur appelle /lf-api/*, Next relaie vers API_PROXY_TARGET côté serveur.
# Pour appeler l'API en direct (une fois le CORS ouvert côté backend) :
#   NEXT_PUBLIC_API_URL=https://lf-api.labsfood.fr
NEXT_PUBLIC_API_URL=/lf-api
API_PROXY_TARGET=https://lf-api.labsfood.fr

# Next public variables (accessibles dans le navigateur)
NEXT_PUBLIC_SITE_URL=http://localhost:8035
